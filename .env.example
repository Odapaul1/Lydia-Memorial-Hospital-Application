# Copy to `.env` and fill in. `.env` is git-ignored.

# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin of the deployed site. Required in production for CSRF checks
# (e.g. https://lydiamemorialhospital.com). Leave blank for localhost.
APP_ORIGIN=

# ---- database (MySQL) ------------------------------------------------------
# Railway/Render supply this automatically when you attach a MySQL service.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/lmh
# TLS mode: disable (local server) | require (TLS, no cert check — Railway/Render)
# | verify (TLS with full certificate verification — CA-signed hosts).
DATABASE_SSL=require

# ---- admin sign-in ---------------------------------------------------------
# Random string of at least 32 characters. Used to sign admin session cookies.
SESSION_SECRET=replace-this-with-a-long-random-string-min-32-chars
# The single email address allowed into /admin.
ADMIN_EMAIL=owner@example.com
# Preferred: run `pnpm admin:hash-password "your password"` and paste the result.
ADMIN_PASSWORD_HASH=
# Quick local fallback only. Ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=

# ---- media storage ---------------------------------------------------------
# local = files written to MEDIA_LOCAL_DIR and served from /media/...
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces)
MEDIA_DRIVER=local

# Only used when MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.media

# Only used when MEDIA_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional CDN/bucket public base URL. When blank, images are proxied through
# the app at /media/<key>.
MEDIA_PUBLIC_BASE_URL=
